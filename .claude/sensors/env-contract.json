{
  "id": "env-contract",
  "title": "Environment contract",
  "kind": "env-contract",
  "domain": "security",
  "feeds": "configuration",
  "invariant": "every environment variable read by code is documented by name in the environment contract documents",
  "paths": [
    "app",
    "lib",
    "modules",
    "scripts"
  ],
  "ignore": [
    "NODE_ENV",
    "GITHUB_ACTIONS"
  ],
  "documents": [
    ".env.example",
    "docs/ENVIRONMENT_CONTRACT.md",
    "infra/env/production.env.example"
  ]
}
