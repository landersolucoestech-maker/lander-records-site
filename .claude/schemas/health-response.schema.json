{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GET /api/health/",
  "type": "object",
  "required": [
    "status",
    "application",
    "database"
  ],
  "properties": {
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "application": {
      "const": "ok"
    },
    "database": {
      "enum": [
        "ok",
        "error"
      ]
    }
  }
}
