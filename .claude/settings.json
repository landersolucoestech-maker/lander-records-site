{
  "version": 1,
  "runtime": "claude-code",
  "branchPolicy": {
    "only": "dev",
    "frozen": [
      "main"
    ],
    "pullRequests": false,
    "forcePush": false
  },
  "approval": {
    "required": [
      "destructive",
      "publishing",
      "credential-change",
      "permission-change",
      "billing",
      "irreversible-external-action"
    ]
  },
  "evidence": {
    "requiredForCompletion": true
  },
  "capabilityUnavailable": "CAPABILITY_UNAVAILABLE"
}
