{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claude approval Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_id",
    "action",
    "reason",
    "status"
  ],
  "properties": {
    "approval_id": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired"
      ]
    }
  }
}
