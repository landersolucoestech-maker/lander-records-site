{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lander-os/evidence",
  "title": "Evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "findings",
    "summary",
    "result",
    "commit",
    "environment",
    "recordedAt",
    "producer",
    "prevHash",
    "hash",
    "fingerprint"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EV-\\d{4}$"
    },
    "kind": {
      "enum": [
        "command",
        "trace",
        "test",
        "build",
        "runtime",
        "browser",
        "integration",
        "lead",
        "security",
        "performance",
        "release",
        "review"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^F-\\d{4}$"
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^C-\\d{3}$"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "string"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "exitCode": {
      "type": "integer"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "OBSERVED"
      ]
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "dirty": {
      "type": "boolean"
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "outputSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "excerpt": {
      "type": "string",
      "maxLength": 4000
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "prevHash": {
      "type": "string",
      "pattern": "^(GENESIS|[0-9a-f]{64})$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mission": {
      "type": [
        "string",
        "null"
      ]
    },
    "ticket": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missionHash": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
