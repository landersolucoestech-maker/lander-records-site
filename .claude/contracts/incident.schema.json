{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lander-os/incident",
  "title": "Incident",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "severity",
    "status",
    "detectedAt",
    "symptoms"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^INC-\\d{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "SEV1",
        "SEV2",
        "SEV3"
      ]
    },
    "status": {
      "enum": [
        "DETECTED",
        "CONTAINED",
        "MITIGATED",
        "RESOLVED",
        "POSTMORTEM_DONE"
      ]
    },
    "detectedAt": {
      "type": "string",
      "format": "date-time"
    },
    "symptoms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "containment": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rootCause": {
      "type": "string"
    },
    "prevention": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
