{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claude skill Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "purpose",
    "inputs",
    "procedure",
    "validation",
    "outputs",
    "failure"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "procedure": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "failure": {
      "type": "object"
    }
  }
}
