{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lander-os/mission",
  "title": "Mission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "objective",
    "status",
    "startedAt",
    "baseCommit",
    "branch",
    "verdict"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PLANNED",
        "ACTIVE",
        "BLOCKED",
        "COMPLETED",
        "ABORTED"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "baseCommit": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "PENDING"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requirements": {
      "type": "array"
    },
    "closedAt": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string"
    }
  }
}
