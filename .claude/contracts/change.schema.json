{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lander-os/change",
  "title": "Change set (one atomic commit cluster)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "findings",
    "files",
    "impactLevel",
    "validations",
    "rollback"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "impactLevel": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ]
    },
    "validations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commit": {
      "type": "string",
      "minLength": 1
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    }
  }
}
