{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lander-os/task",
  "title": "Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "owner",
    "files",
    "steps",
    "validations",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "finding": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "PENDING",
        "IN_PROGRESS",
        "DONE",
        "BLOCKED"
      ]
    }
  }
}
