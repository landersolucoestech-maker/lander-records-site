{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lander-os/agent",
  "title": "Agent definition (front matter of .claude/agents/**.md)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "domain",
    "kind",
    "mode"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "lead",
        "subagent",
        "auditor",
        "reviewer",
        "guardian",
        "integration"
      ]
    },
    "owns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mode": {
      "enum": [
        "read",
        "write"
      ]
    }
  }
}
