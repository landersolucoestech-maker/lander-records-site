{
  "id": "security",
  "title": "Security gate (L5)",
  "checks": [
    {
      "name": "auth tests",
      "type": "command",
      "argv": [
        "npm",
        "run",
        "test:auth"
      ]
    },
    {
      "name": "spotify security tests",
      "type": "command",
      "argv": [
        "npm",
        "run",
        "test:spotify"
      ]
    },
    {
      "name": "no secret exposed via NEXT_PUBLIC",
      "type": "forbidden-pattern",
      "paths": [
        "app",
        "lib",
        "modules"
      ],
      "pattern": "NEXT_PUBLIC_\\w*(SECRET|KEY|TOKEN|PASSWORD)",
      "message": "secrets must not be public env"
    },
    {
      "name": "no open P0/P1 security findings",
      "type": "no-open-findings",
      "domains": [
        "security"
      ]
    },
    {
      "name": "preview bypass flag function unchanged",
      "type": "required-pattern",
      "file": "lib/auth/development-bypass.ts",
      "pattern": "export function isDisposablePreviewAuthBypassEnabled\\(\\s*environment: DevelopmentAuthEnvironment = process\\.env,\\s*\\): boolean \\{\\s*return \\(\\s*environment\\.NODE_ENV === \"production\" &&\\s*environment\\.GITHUB_ACTIONS === \"true\" &&\\s*environment\\.DEV_PREVIEW_PUBLIC_ACCESS === \"true\"\\s*\\);\\s*\\}",
      "message": "preview bypass conditions changed \u2014 L5 review required"
    },
    {
      "name": "admin bypass composition unchanged",
      "type": "required-pattern",
      "file": "lib/auth/development-bypass.ts",
      "pattern": "export function isAdminAuthBypassAllowed\\(\\s*host: string \\| null \\| undefined,\\s*environment: DevelopmentAuthEnvironment = process\\.env,\\s*\\): boolean \\{\\s*return \\(\\s*isDevelopmentAuthBypassAllowed\\(host, environment\\) \\|\\|\\s*\\(isDisposablePreviewAuthBypassEnabled\\(environment\\) && isDisposablePreviewRequestHost\\(host\\)\\)\\s*\\);\\s*\\}",
      "message": "admin bypass composition changed \u2014 L5 review required"
    },
    {
      "name": "public preview workflow safety (structured)",
      "type": "preview-workflow-safety",
      "file": ".github/workflows/dev-preview.yml",
      "pinned": {
        "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/lander_records_preview",
        "LANDER_MOCK_DATA": "1"
      },
      "allowedEnvWrites": [
        "APP_PID",
        "TUNNEL_PID",
        "PREVIEW_URL"
      ]
    }
  ]
}
