{
  "type": "object",
  "required": [
    "id",
    "kind",
    "status",
    "authority"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PLANNED",
        "STARTED",
        "SUCCEEDED",
        "FAILED",
        "PARTIAL",
        "RECONCILED"
      ]
    },
    "authority": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "A3",
        "A4",
        "A5"
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
