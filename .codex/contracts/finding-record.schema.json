{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lander-records.invalid/codex/contracts/finding-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "severity", "status", "summary", "reporterExecutionId", "createdAt", "updatedAt", "history"],
  "properties": {
    "id": {"type": "string", "minLength": 1}, "severity": {"enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL", "BLOCKER"]},
    "status": {"enum": ["OPEN", "FIX_IN_PROGRESS", "FIXED_PENDING_VERIFICATION", "VERIFIED", "CLOSED", "WAIVED_PENDING_APPROVAL", "WAIVED", "BLOCKED"]},
    "summary": {"type": "string", "minLength": 1}, "reporterExecutionId": {"type": "string"}, "fixExecutionId": {"type": ["string", "null"]}, "verifierExecutionId": {"type": ["string", "null"]},
    "resolutionReference": {"type": ["string", "null"]}, "fixFingerprint": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "verificationEvidenceIds": {"type": "array", "items": {"type": "string"}}, "createdAt": {"type": "string", "format": "date-time"}, "updatedAt": {"type": "string", "format": "date-time"},
    "history": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["from", "to", "executionId", "at"], "properties": {"from": {"type": ["string", "null"]}, "to": {"type": "string"}, "executionId": {"type": "string"}, "at": {"type": "string", "format": "date-time"}, "reason": {"type": ["string", "null"]}}}}
  }
}
