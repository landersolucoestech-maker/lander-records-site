{
  "type": "object",
  "required": [
    "level",
    "risk",
    "signals"
  ],
  "properties": {
    "level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ]
    },
    "risk": {
      "enum": [
        "low",
        "moderate",
        "high",
        "critical"
      ]
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authorityRequired": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "A3",
        "A4",
        "A5"
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
