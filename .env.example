# Dynamic runtime
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Admin / security
CONTACT_IP_HASH_SALT=replace-with-a-long-random-secret

# One-time owner bootstrap. Do not commit real values.
ADMIN_BOOTSTRAP_EMAIL=owner@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-12+-characters
ADMIN_BOOTSTRAP_NAME=Lander Records Owner

# Media storage
BLOB_READ_WRITE_TOKEN=

# Integration secret storage. Generate 32 random bytes and encode them as base64.
# Example command: openssl rand -base64 32
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# Spotify Web API — Authorization Code flow.
# SPOTIFY_REDIRECT_URI must exactly match a redirect URI registered in the Spotify app.
# Example: https://your-runtime.example.com/api/integrations/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# Soundcharts — OAuth client credentials (current API authentication).
# SOUNDCHARTS_TEAM_ID is optional and only needed when your Soundcharts client is scoped to a specific team.
SOUNDCHARTS_CLIENT_ID=
SOUNDCHARTS_CLIENT_SECRET=
SOUNDCHARTS_TEAM_ID=

# Protects /api/cron/integrations. Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Future SaaS integration. Leave unset until the real SaaS endpoint exists.
LANDER_SAAS_WEBHOOK_URL=
LANDER_SAAS_WEBHOOK_SECRET=
